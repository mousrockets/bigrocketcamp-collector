{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Big Rocket Camp Direct",
  "identifier": "com.mousrockets.direct",
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Big Rocket Camp",
    "copyright": "MIT",
    "category": "Utility",
    "shortDescription": "Envoie les tableaux de fin de match Rocket League à Big Rocket Camp",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
